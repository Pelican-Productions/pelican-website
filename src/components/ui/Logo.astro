---
import { pelicanMark } from '@/data/site';
import { cn } from '@/lib/cn';

interface Props {
    /** header (compact) or footer (slightly larger). */
    size?: 'header' | 'footer' | undefined;

    href?: string | undefined;

    class?: string | undefined;
}

const { size = 'header', href = '/', class: className } = Astro.props;
const footer = size === 'footer';

const productions = [...'PRODUCTIONS'];
---

<a
    href={href}
    aria-label="Pelican Productions"
    class={cn('lockup', footer && 'is-footer', className)}
>
    <img
        class="mark"
        src={pelicanMark.src}
        alt=""
        aria-hidden="true"
        width={pelicanMark.width}
        height={pelicanMark.height}
    />
    <span
        class="word"
        aria-hidden="true"
    >
        <span class="name">PELICAN</span>
        <span class="sub">
            {productions.map(letter => <span>{letter}</span>)}
        </span>
    </span>
</a>

<style>
    .lockup {
        display: flex;
        flex-shrink: 0;
        align-items: center;
        gap: 0.42em;
        color: #fff;
        font-size: 1.35rem;
        text-decoration: none;
    }

    .lockup.is-footer {
        font-size: 1.7rem;
    }

    @media (width >= 56.25rem) {
        .lockup:not(.is-footer) {
            font-size: 1.85rem;
        }
    }

    /* The SVG pads the pelican so its neon glow isn't clipped; the negative
       margin keeps the drawn bird where it sat before. */
    .mark {
        width: auto;
        height: 2.38em;
        margin: -0.19em -0.13em;
    }

    .word {
        display: flex;
        flex-direction: column;
        gap: 0.14em;
        font-family: var(--font-brand);
    }

    .name {
        font-size: 1em;
        font-weight: 800;
        line-height: 0.8;
        letter-spacing: -0.035em;
    }

    .sub {
        display: flex;
        justify-content: space-between;
        font-size: 0.34em;
        font-weight: 500;
        line-height: 1;
    }
</style>
