---
import Kicker from '@/components/ui/Kicker.astro';
import { cn } from '@/lib/cn';

interface Props {
    title: string;
    kicker?: string | undefined;

    /** Optional link; the title becomes the link. */
    href?: string | undefined;

    class?: string | undefined;
}

const { title, kicker, href, class: className } = Astro.props;
---

<article
    class={cn(
        'border-t-4 border-[var(--tone-rule)] pt-[22px] text-[var(--tone-lead)] [&_p]:mb-3',
        className,
    )}
>
    {kicker && <Kicker>{kicker}</Kicker>}
    <h3
        class="font-display tracking-tightish mt-1 mb-3 text-[1.7rem] leading-[1.1] font-extrabold text-[var(--tone-heading)] uppercase"
    >
        {
            href ? (
                <a
                    href={href}
                    class="decoration-pink no-underline decoration-[3px] underline-offset-4 hover:underline"
                >
                    {title}
                </a>
            ) : (
                title
            )
        }
    </h3>
    <slot />
</article>
