---
import { cn } from '@/lib/cn';

interface Props {
    src: string;
    alt: string;
    width?: number | undefined;

    height?: number | undefined;

    /** CSS object-position, e.g. "50% 22%" (default) or "center". */
    position?: string | undefined;

    class?: string | undefined;
}

const {
    src,
    alt,
    width = 1600,
    height = 600,
    position = '50% 22%',
    class: className,
} = Astro.props;
---

<section class={cn('bg-navy', className)}>
    <figure class="m-0">
        <img
            src={src}
            alt={alt}
            width={width}
            height={height}
            loading="lazy"
            decoding="async"
            class="block h-[clamp(260px,34vw,480px)] w-full object-cover"
            style={{ objectPosition: position }}
        />
    </figure>
</section>
