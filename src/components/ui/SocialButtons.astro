---
import SocialIcon from '@/components/ui/SocialIcon.astro';
import { socials } from '@/data/site';
import { cn } from '@/lib/cn';

interface Props {
    class?: string | undefined;
}

const { class: className } = Astro.props;
---

<div class={cn('mt-[22px] flex flex-wrap gap-[22px]', className)}>
    {
        socials.map(social => (
            <a
                class="rounded-btn bg-navy flex items-center gap-3.5 border border-white px-6 py-4 text-white no-underline transition-transform hover:-translate-x-0.5 hover:-translate-y-0.5"
                href={social.href}
                target="_blank"
                rel="noopener"
            >
                <SocialIcon
                    name={social.name}
                    class="size-[34px] shrink-0"
                />
                <span>
                    <b class="font-ui block text-[1.2rem] leading-tight">
                        {social.name}
                    </b>
                    <small class="font-mono text-[0.8rem] opacity-90">
                        {social.handle}
                    </small>
                </span>
            </a>
        ))
    }
</div>
