---
import { cn } from '@/lib/cn';

interface Props {
    /** Columns at desktop. Collapses to 2 then 1 on smaller screens. */
    cols?: 2 | 3 | 4 | undefined;

    /** Gap preset: paths (40px), cards (30px), tight (22px). */
    gap?: 'paths' | 'cards' | 'tight' | undefined;

    as?: 'div' | 'ul' | undefined;

    class?: string | undefined;
}

const {
    cols = 3,
    gap = 'cards',
    as: Tag = 'div',
    class: className,
} = Astro.props;

const colClass = {
    2: 'md:grid-cols-2',
    3: 'sm:grid-cols-2 lg:grid-cols-3',
    4: 'sm:grid-cols-2 lg:grid-cols-4',
}[cols];

const gapClass = {
    paths: 'gap-10',
    cards: 'gap-[30px]',
    tight: 'gap-[22px]',
}[gap];
---

<Tag class={cn('mt-[26px] grid grid-cols-1', colClass, gapClass, className)}>
    <slot />
</Tag>
