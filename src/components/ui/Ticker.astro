---
interface Props {
    /** Short news items. Every second item is shown white-on-cobalt, as in v56. */
    items: string[];
    label?: string | undefined;

    /** Seconds per loop. */
    duration?: number | undefined;
}

const { items, label = 'Latest news', duration = 40 } = Astro.props;
---

<div
    class="ticker"
    role="region"
    aria-label={label}
    style={{ '--dur': `${duration}s` }}
>
    <div class="track">
        {items.map(item => <span>{item}</span>)}
        {
            items.map(item => (
                <span
                    class="dup"
                    aria-hidden="true"
                >
                    {item}
                </span>
            ))
        }
    </div>
</div>

<style>
    .ticker {
        overflow: hidden;
        background: var(--color-cobalt);
        white-space: nowrap;
    }

    .track {
        display: inline-flex;
        width: max-content;
        animation: tick var(--dur, 40s) linear infinite;
    }

    .ticker:hover .track,
    .ticker:focus-within .track {
        animation-play-state: paused;
    }

    span {
        padding: 10px 0 8px;
        margin-right: 46px;
        font: 600 1rem/1.5 var(--font-sans);
        color: #fff;
    }

    @media (prefers-reduced-motion: reduce) {
        .ticker {
            overflow-x: auto;
        }
        .track {
            animation: none;
        }
        .dup {
            display: none;
        }
    }
</style>
