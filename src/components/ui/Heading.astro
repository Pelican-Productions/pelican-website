---
import { cn } from '@/lib/cn';
import { inlineHtml } from '@/lib/content-text';

interface Props {
    as?: 'h1' | 'h2' | 'h3' | 'h4' | undefined;

    /** Visual size, independent of level. Defaults to match the level. */
    size?: 'hero' | 'h2' | 'h3' | 'h4' | undefined;

    /**
     * Content string (see src/lib/content-text.ts): ==word== becomes a <mark>,
     * e.g. "Follow the ==flock==". Alternatively pass children with <mark>.
     */
    text?: string | undefined;

    align?: 'left' | 'center' | undefined;

    id?: string | undefined;

    /**
     * A custom size (text-[...]) replaces the size token and its line-height;
     * h1-h3 then fall back to the base 1.02. Pass leading-* to change that.
     */
    class?: string | undefined;
}

const {
    as: Tag = 'h2',
    size,
    text,
    align = 'left',
    id,
    class: className,
} = Astro.props;

const resolved = size ?? (Tag === 'h1' ? 'hero' : Tag);

const sizes: Record<string, string> = {
    hero: 'text-hero mb-[0.5em]',
    h2: 'text-h2 mb-[0.45em] uppercase',
    h3: 'text-[1.7rem] leading-[1.1] mb-3 uppercase',
    h4: 'text-[1.25rem] leading-[1.2] mb-2',
};

const html = text ? inlineHtml(text) : undefined;
---

{
    html ? (
        <Tag
            id={id}
            class={cn(
                'font-display tracking-tightish font-extrabold text-[var(--tone-heading)]',
                sizes[resolved],
                align === 'center' && 'text-center',
                className,
            )}
            set:html={html}
        />
    ) : (
        <Tag
            id={id}
            class={cn(
                'font-display tracking-tightish font-extrabold text-[var(--tone-heading)]',
                sizes[resolved],
                align === 'center' && 'text-center',
                className,
            )}
        >
            <slot />
        </Tag>
    )
}
