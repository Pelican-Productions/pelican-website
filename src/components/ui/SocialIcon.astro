---
interface Props {
    name: 'Facebook' | 'Instagram' | 'TikTok';
    class?: string | undefined;
}

const { name, class: className } = Astro.props;
---

<svg
    viewBox="0 0 24 24"
    aria-hidden="true"
    focusable="false"
    class={className}
>
    {
        name === 'Facebook' && (
            <path
                d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.6-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H7.9v3h2.6V21"
                fill="currentColor"
            />
        )
    }
    {
        name === 'Instagram' && (
            <>
                <rect
                    x="3"
                    y="3"
                    width="18"
                    height="18"
                    rx="5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                />
                <circle
                    cx="12"
                    cy="12"
                    r="4"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                />
                <circle
                    cx="17.3"
                    cy="6.7"
                    r="1.3"
                    fill="currentColor"
                />
            </>
        )
    }
    {
        name === 'TikTok' && (
            <>
                <path
                    d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                />
                <path
                    d="M14 3c.4 2.8 2.2 4.6 5 5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                />
            </>
        )
    }
</svg>
