---
import { cn } from '@/lib/cn';

export interface Stat {
    /** Big number/word, e.g. "25+" */
    value: string;
    label: string;
}

interface Props {
    items: Stat[];
    class?: string | undefined;
}

const { items, class: className } = Astro.props;
---

<dl class={cn('mt-2.5 grid gap-x-11 gap-y-6 sm:grid-cols-3', className)}>
    {
        items.map(item => (
            <div class="flex flex-col-reverse">
                <dt class="text-[var(--tone-lead)]">{item.label}</dt>
                <dd class="font-condensed text-berry mb-2 text-[clamp(3rem,6vw,4.6rem)] leading-[0.9] tracking-[0.01em] uppercase">
                    {item.value}
                </dd>
            </div>
        ))
    }
</dl>
