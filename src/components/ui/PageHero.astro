---
import CtaRow, { type Cta } from '@/components/ui/CtaRow.astro';
import Heading from '@/components/ui/Heading.astro';
import Kicker from '@/components/ui/Kicker.astro';
import { pelicanLayers } from '@/data/site';
import { cn } from '@/lib/cn';

interface Props {
    /** h1 text; wrap words in ==equals== for a yellow <mark>. Or use the "heading" slot. */
    heading?: string | undefined;

    /** Intro paragraph. The default slot is rendered after it (extra copy, badges...). */
    intro?: string | undefined;

    kicker?: string | undefined;

    ctas?: Cta[] | undefined;

    /**
     * Replace the artwork on the right (decorative, so alt is empty). Defaults
     * to the flat Pelican mark from the header, the same on every page.
     */
    image?: { src: string; width: number; height: number } | undefined;
    /** Hide the dotted flight-path squiggle. */
    flight?: boolean | undefined;

    class?: string | undefined;
}

const {
    heading,
    intro,
    kicker,
    ctas = [],
    image,
    flight = true,
    class: className,
} = Astro.props;
---

<section
    class={cn('hero-sub', className)}
    data-tone="paper"
>
    {
        flight && (
            <svg
                class="flight"
                viewBox="0 0 520 240"
                aria-hidden="true"
                focusable="false"
            >
                <path d="M168 30 C 128 92, 26 104, 30 168 C 34 236, 176 236, 178 166 C 180 104, 64 112, 92 190 C 112 242, 224 242, 322 204" />
            </svg>
        )
    }
    {
        image ? (
            <img
                class="art"
                src={image.src}
                width={image.width}
                height={image.height}
                alt=""
                aria-hidden="true"
                decoding="async"
            />
        ) : (
            <span
                class="art mark"
                aria-hidden="true"
            >
                {pelicanLayers.map(src => (
                    <img
                        src={src}
                        alt=""
                        width="260"
                        height="244"
                        decoding="async"
                    />
                ))}
            </span>
        )
    }
    <div class="wrap">
        {kicker && <Kicker>{kicker}</Kicker>}
        {
            heading ? (
                <Heading
                    as="h1"
                    text={heading}
                    class="text-[clamp(2.6rem,6vw,5rem)] leading-[1.02]"
                />
            ) : (
                <Heading
                    as="h1"
                    class="text-[clamp(2.6rem,6vw,5rem)] leading-[1.02]"
                >
                    <slot name="heading" />
                </Heading>
            )
        }
        {intro && <p class="intro">{intro}</p>}
        <slot />
        {ctas.length > 0 && <CtaRow ctas={ctas} />}
    </div>
</section>

<style>
    .hero-sub {
        position: relative;
        overflow: hidden;
        padding: 84px 0 92px;
        background:
            radial-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1.6px) 0
                0 / 22px 22px,
            radial-gradient(
                50% 70% at 88% 100%,
                rgba(30, 40, 210, 0.55),
                transparent 70%
            ),
            radial-gradient(
                45% 60% at 8% 0%,
                rgba(91, 216, 253, 0.16),
                transparent 70%
            ),
            var(--color-navy);
        color: #fff;
    }

    /* Keep copy clear of the artwork (v56: .hero.sub .wrap>*). */
    @media (min-width: 901px) {
        .wrap > :global(*) {
            max-width: 62%;
        }
    }

    .intro {
        font-size: 1.15rem;
        line-height: 1.6;
        color: var(--color-peri);
    }

    .flight {
        position: absolute;
        z-index: 0;
        top: 50%;
        right: 180px;
        width: min(360px, 28vw);
        transform: translateY(-38%);
        fill: none;
        overflow: visible;
        pointer-events: none;
    }

    .flight path {
        stroke: var(--color-ice);
        stroke-width: 3;
        stroke-dasharray: 2 14;
        stroke-linecap: round;
        opacity: 0.9;
        animation: var(--animate-dash);
    }

    /* Sits under .wrap (z-index 1) so copy always paints over the artwork. */
    .art {
        position: absolute;
        z-index: 0;
        top: 50%;
        right: 70px;
        width: 280px;
        height: auto;
        transform: translateY(-50%);
        pointer-events: none;
    }

    .mark {
        display: grid;
        aspect-ratio: 260 / 244;
    }

    .mark img {
        grid-area: 1 / 1;
        width: 100%;
        height: 100%;
    }

    @media (max-width: 900px) {
        .hero-sub {
            padding: 72px 0 92px;
        }

        .art {
            top: 20px;
            right: 14px;
            width: 92px;
            transform: none;
            opacity: 0.55;
        }

        .flight {
            display: none;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .flight path {
            animation: none;
        }
    }
</style>
