---
import { cn } from '@/lib/cn';

type Variant = 'primary' | 'enrol' | 'ghost' | 'dark' | 'light';
type Shadow = 'tone' | 'navy' | 'glow' | 'none';

interface Props {
    /** Renders an <a> when set, otherwise a <button>. */
    href?: string | undefined;
    /**
     * primary: cobalt fill (default). enrol: hot pink (enrolment links).
     * ghost: outline that follows the section tone. dark: navy fill (on pink/ice).
     * light: white fill with navy text, for dark or photo backgrounds.
     */
    variant?: Variant | undefined;

    /**
     * Hard offset shadow, same on every variant. "tone" picks navy on light
     * sections, glow-blue on dark. Dark buttons default to glow.
     */
    shadow?: Shadow | undefined;

    size?: 'md' | 'sm' | undefined;

    /** Opens in a new tab with rel=noopener. Auto-on for absolute http(s) URLs. */
    external?: boolean | undefined;
    type?: 'button' | 'submit' | 'reset' | undefined;

    class?: string | undefined;

    [key: `data-${string}`]: string | undefined;
    'aria-label'?: string;
}

const {
    href,
    variant = 'primary',
    shadow = 'tone',
    size = 'md',
    external,
    type = 'button',
    class: className,
    ...rest
} = Astro.props;

const isExternal = external ?? (href ? /^https?:\/\//.test(href) : false);

const variants: Record<Variant, string> = {
    primary: 'bg-cobalt-deep text-white border-cobalt-deep',
    enrol: 'bg-hot text-white border-hot',
    ghost: 'bg-[var(--tone-bg,transparent)] border-[var(--tone-ghost)] text-[var(--tone-ghost-text)]',
    dark: 'bg-navy text-white border-navy',
    light: 'bg-white text-navy border-white',
};

const shadows: Record<Shadow, string> = {
    tone: 'shadow-[var(--tone-btn-shadow)]',
    navy: 'shadow-hard',
    glow: 'shadow-hard-glow',
    none: 'shadow-none',
};

// Every variant gets the same hard offset shadow. A navy shadow would vanish
// behind a navy fill, so dark buttons default to the glow offset.
const shadowClass =
    variant === 'dark' && Astro.props.shadow === undefined
        ? shadows.glow
        : shadows[shadow];

const classes = cn(
    'inline-block rounded-btn border-[1.5px] text-center font-ui leading-[1.2] font-bold no-underline',
    'transition-[transform,box-shadow] duration-150 hover:-translate-x-0.5 hover:-translate-y-0.5 active:translate-0',
    size === 'md'
        ? 'px-7 py-[15px] text-base'
        : 'px-[18px] py-[9px] text-[0.9rem]',
    variants[variant],
    shadowClass,
    className,
);
---

{
    href ? (
        <a
            href={href}
            class={classes}
            {...(isExternal ? { target: '_blank', rel: 'noopener' } : {})}
            {...rest}
        >
            <slot />
        </a>
    ) : (
        <button
            type={type}
            class={classes}
            {...rest}
        >
            <slot />
        </button>
    )
}
