---
import SiteNav from '@/components/layout/SiteNav.astro';
import Logo from '@/components/ui/Logo.astro';
import { site } from '@/data/site';

interface Props {
    /** Top-level nav key to mark as the current section. */
    active?: string | undefined;
}

const { active } = Astro.props;
---

<header
    class="top border-line bg-navy relative z-[96] border-b"
    data-site-header
>
    <div class="wrap flex min-h-24 items-center gap-4 py-[13px]">
        <Logo />
        <button
            type="button"
            class="menubtn"
            aria-expanded="false"
            aria-controls="nav"
            data-menu-toggle
        >
            <span
                class="bars"
                aria-hidden="true"
            ></span>
            <span data-menu-label>Menu</span>
        </button>
        <a
            class="rounded-btn bg-hot font-ui shadow-hard-glow nav:inline-block ml-auto hidden px-7 py-[15px] text-[0.95rem] leading-none font-bold text-white no-underline transition-transform hover:-translate-x-0.5 hover:-translate-y-0.5"
            href={site.enrolPath}
            >Enrol now</a
        >
    </div>
</header>
<SiteNav active={active} />

<style>
    .menubtn {
        display: none;
    }

    @media (width < 56.25rem) {
        .menubtn {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            margin-left: auto;
            padding: 10px 14px;
            border: 3px solid #fff;
            background: none;
            color: #fff;
            font: 700 1rem/1 var(--font-ui);
            cursor: pointer;
        }
    }

    .bars,
    .bars::before,
    .bars::after {
        display: block;
        width: 18px;
        height: 2px;
        background: currentColor;
        transition:
            transform 0.2s,
            background 0.2s;
    }

    .bars {
        position: relative;
    }

    .bars::before,
    .bars::after {
        content: '';
        position: absolute;
        left: 0;
    }

    .bars::before {
        top: -6px;
    }

    .bars::after {
        top: 6px;
    }

    .menubtn[aria-expanded='true'] .bars {
        background: transparent;
    }

    .menubtn[aria-expanded='true'] .bars::before {
        transform: translateY(6px) rotate(45deg);
    }

    .menubtn[aria-expanded='true'] .bars::after {
        transform: translateY(-6px) rotate(-45deg);
    }
</style>

<script>
    const root = document.documentElement;

    function setScrolled() {
        root.toggleAttribute('data-scrolled', window.scrollY > 200);
    }

    function closeMenu() {
        root.removeAttribute('data-nav-open');
        const button =
            document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
        if (!button) return;
        button.setAttribute('aria-expanded', 'false');
        const label = button.querySelector('[data-menu-label]');
        if (label) label.textContent = 'Menu';
    }

    // Window-level listeners: register once per full page load.
    window.addEventListener('scroll', setScrolled, { passive: true });
    document.addEventListener('keydown', event => {
        if (event.key !== 'Escape') return;
        if (root.hasAttribute('data-nav-open')) {
            closeMenu();
            document
                .querySelector<HTMLButtonElement>('[data-menu-toggle]')
                ?.focus();
            return;
        }
        // Collapse an open desktop dropdown by moving focus to its parent link.
        const active = document.activeElement;
        const dd = active?.closest('.dd');
        if (dd && active !== dd.firstElementChild) {
            (dd.firstElementChild as HTMLElement | null)?.focus();
        }
    });
    document.addEventListener('astro:before-swap', closeMenu);

    // Element-level setup: body is swapped by ClientRouter, so re-bind per page.
    document.addEventListener('astro:page-load', () => {
        setScrolled();
        const button =
            document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
        const header =
            document.querySelector<HTMLElement>('[data-site-header]');
        if (!button || !header) return;

        button.addEventListener('click', () => {
            const open = !root.hasAttribute('data-nav-open');
            if (open) {
                root.style.setProperty(
                    '--header-h',
                    `${header.getBoundingClientRect().bottom}px`,
                );
            }
            root.toggleAttribute('data-nav-open', open);
            button.setAttribute('aria-expanded', String(open));
            const label = button.querySelector('[data-menu-label]');
            if (label) label.textContent = open ? 'Close' : 'Menu';
        });
    });
</script>
