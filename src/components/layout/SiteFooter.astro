---
import Logo from '@/components/ui/Logo.astro';
import { footer, site, socials } from '@/data/site';

const colHeading =
    'mb-3 font-mono text-[0.78rem] font-bold tracking-[0.16em] text-glow uppercase';
// v56: column copy is periwinkle, links white with a pink hover.
const link = 'text-white no-underline hover:text-pink';
---

<footer
    class="border-line-soft bg-navy text-link max-nav:pb-24 border-t pt-14 pb-7 text-base leading-[1.6]"
>
    <div class="wrap">
        <div
            class="grid gap-9 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1.3fr_1fr]"
        >
            <Logo
                size="footer"
                class="self-start sm:col-span-2 lg:col-span-1"
            />
            <div>
                <h2 class={colHeading}>{footer.visit.heading}</h2>
                <p>
                    {
                        footer.visit.lines.map((line, i) => (
                            <>
                                {i > 0 && <br />}
                                {line}
                            </>
                        ))
                    }
                </p>
            </div>
            <div>
                <h2 class={colHeading}>{footer.contact.heading}</h2>
                <ul class="space-y-1.5">
                    {
                        footer.contact.items.map(item => (
                            <li class="break-words">
                                {item.href ? (
                                    <a
                                        class={link}
                                        href={item.href}
                                        {...(item.external
                                            ? {
                                                  target: '_blank',
                                                  rel: 'noopener',
                                              }
                                            : {})}
                                    >
                                        {item.label}
                                    </a>
                                ) : (
                                    item.label
                                )}
                            </li>
                        ))
                    }
                </ul>
            </div>
            <div>
                <h2 class={colHeading}>{footer.follow.heading}</h2>
                <ul class="space-y-1.5">
                    {
                        socials.map(social => (
                            <li>
                                <a
                                    class={link}
                                    href={social.href}
                                    target="_blank"
                                    rel="noopener"
                                >
                                    {social.name}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>
        <div
            class="mt-10 flex flex-wrap justify-between gap-x-7 gap-y-3 border-t border-white/[0.18] pt-[18px] text-[0.82rem] opacity-85"
        >
            <p>
                &copy; {site.name} &middot; <a
                    class="underline hover:text-white"
                    href="/"
                    >Back to home</a
                >
            </p>
            <p>{footer.credits}</p>
        </div>
    </div>
</footer>

<a
    class="rounded-btn bg-hot font-ui shadow-hard nav:hidden fixed right-[18px] bottom-[18px] left-3 z-[99] block p-3.5 text-center text-[1.1rem] font-bold text-white no-underline"
    href={site.enrolUrl}
    target="_blank"
    rel="noopener"
    >Enrol now</a
>
