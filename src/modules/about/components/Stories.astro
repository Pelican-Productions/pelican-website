---
import Heading from '@/components/ui/Heading.astro';
import Lead from '@/components/ui/Lead.astro';
import Section from '@/components/ui/Section.astro';
import { inlineHtml } from '@/lib/content-text';

interface Props {
    heading?: string | undefined;
    lead?: string | undefined;
    /** Handwritten pull quote above the cards. */
    quote?: { text: string; cite?: string | undefined } | undefined;
    items?:
        { title?: string | undefined; text?: string | undefined }[] | undefined;
}

const { heading, lead, quote, items = [] } = Astro.props;
---

<Section tone="paper">
    {heading && <Heading text={heading} />}
    {
        lead && (
            <Lead class="text-white">
                <Fragment set:html={inlineHtml(lead)} />
            </Lead>
        )
    }
    {
        quote && (
            <blockquote class="mt-2.5 mb-[26px]">
                <p
                    class="font-script m-0 max-w-[26ch] text-[clamp(2.1rem,4.6vw,3.6rem)] leading-[1.15] font-semibold text-white"
                    set:html={inlineHtml(`“${quote.text}”`)}
                />
                {quote.cite && (
                    <cite class="mt-3 block font-medium text-[#e6f6ff] not-italic">
                        {quote.cite}
                    </cite>
                )}
            </blockquote>
        )
    }
    <div
        class="mt-2.5 grid grid-cols-[repeat(auto-fit,minmax(240px,1fr))] gap-4"
    >
        {
            items.map(item => (
                <div class="bg-midnight border-t-[3px] border-white/75 px-6 py-[22px] leading-normal text-white">
                    {item.title && (
                        <strong class="text-yellow mb-1.5 block text-[1.1rem]">
                            {item.title}
                        </strong>
                    )}
                    {item.text && <Fragment set:html={inlineHtml(item.text)} />}
                </div>
            ))
        }
    </div>
</Section>
