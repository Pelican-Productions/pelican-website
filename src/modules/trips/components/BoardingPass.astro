---
import type { CollectionEntry } from 'astro:content';
import Button from '@/components/ui/Button.astro';
import Heading from '@/components/ui/Heading.astro';
import Lead from '@/components/ui/Lead.astro';
import Section from '@/components/ui/Section.astro';
import { inlineHtml } from '@/lib/content-text';

interface Props {
    trip: CollectionEntry<'trips'>;
}

const {
    heading,
    lead,
    route = [],
    facts = [],
    pass,
    ctas,
} = Astro.props.trip.data;
const cta = ctas[0];
---

<Section>
    {heading && <Heading text={heading} />}
    {
        lead && (
            <Lead>
                <Fragment set:html={inlineHtml(lead)} />
            </Lead>
        )
    }
    <div
        class="pass border-navy mt-[30px] grid grid-cols-[minmax(0,1fr)] border-2 bg-white shadow-[0_11px_24px_rgba(10,14,42,0.16)] md:grid-cols-[1fr_290px]"
    >
        <div
            class="border-pink min-w-0 border-l-[10px] px-5 py-[22px] md:border-l-[14px] md:px-8 md:pt-7 md:pb-[30px]"
        >
            {pass && <span class="plabel break-words">{pass.label}</span>}
            <div
                class="route my-5 mb-[26px] flex flex-wrap items-center gap-2 gap-y-3 md:flex-nowrap md:gap-3.5"
            >
                {
                    route.map((stop, i) => (
                        <>
                            {i > 0 && (
                                <div
                                    class="plane"
                                    aria-hidden="true"
                                />
                            )}
                            <div>
                                <b class="font-condensed text-navy block text-[1.45rem] leading-[0.9] font-normal md:text-[clamp(1.6rem,3.8vw,3.4rem)]">
                                    {stop.code}
                                </b>
                                <small class="text-muted hidden font-mono text-[0.72rem] md:inline">
                                    {stop.place}
                                </small>
                            </div>
                        </>
                    ))
                }
            </div>
            <dl
                class="grid grid-cols-2 gap-x-[18px] gap-y-3 md:grid-cols-4 md:gap-x-5 md:gap-y-0"
            >
                {
                    facts.map(fact => (
                        <div class="border-navy border-t-2 pt-2">
                            <dt class="plabel">{fact.label}</dt>
                            <dd class="text-navy font-mono text-[0.95rem] font-bold">
                                {fact.value}
                            </dd>
                        </div>
                    ))
                }
            </dl>
        </div>
        {
            pass && (
                <div class="bg-lightblue border-navy text-navy flex flex-col items-start gap-1 border-t-[3px] border-dashed px-[26px] py-7 md:border-t-0 md:border-l-[3px]">
                    <span class="plabel !text-navy">{pass.stub.label}</span>
                    <b class="font-condensed text-[3.2rem] leading-none font-normal">
                        {pass.stub.value}
                    </b>
                    <small class="text-[0.85rem]">{pass.stub.text}</small>
                    {cta && (
                        <Button
                            href={cta.href}
                            variant={cta.variant}
                            shadow="navy"
                            class="mt-3"
                        >
                            {cta.label}
                        </Button>
                    )}
                </div>
            )
        }
    </div>
</Section>

<style>
    .plabel {
        display: block;
        font-family: var(--font-mono);
        font-size: 0.72rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--color-muted);
    }
    .plane {
        position: relative;
        flex: 0 0 18px;
        min-width: 12px;
        height: 0;
        margin-top: -18px;
        border-top: 3px dashed var(--color-navy);
    }
    .plane::after {
        content: '\2708\FE0E';
        position: absolute;
        left: 50%;
        top: -0.78em;
        transform: translateX(-50%);
        padding: 0 6px;
        background: #fff;
        color: var(--color-pink);
        font-size: 0.9rem;
    }
    @media (min-width: 768px) {
        .plane {
            flex: 1;
            min-width: 24px;
        }
        .plane::after {
            font-size: 1.3rem;
        }
    }
</style>
