---
import type { CollectionEntry } from 'astro:content';
import CtaRow from '@/components/ui/CtaRow.astro';
import Facts from '@/components/ui/Facts.astro';
import Grid from '@/components/ui/Grid.astro';
import Heading from '@/components/ui/Heading.astro';
import Lead from '@/components/ui/Lead.astro';
import PathCard from '@/components/ui/PathCard.astro';
import Section from '@/components/ui/Section.astro';
import { inlineHtml } from '@/lib/content-text';

type PageSection = CollectionEntry<'pages'>['data']['sections'][string];

interface Props {
    section: PageSection;
}

const { section } = Astro.props;
const facts = (section.facts ?? []).map(f => ({
    term: f.label,
    detail: inlineHtml(f.value),
}));
---

<Section id={section.id}>
    {section.heading && <Heading text={section.heading} />}
    {
        section.lead && (
            <Lead>
                <Fragment set:html={inlineHtml(section.lead)} />
            </Lead>
        )
    }
    <Grid cols={2}>
        {
            section.items?.map(item => (
                <PathCard
                    title={item.title ?? ''}
                    kicker={item.kicker}
                >
                    {item.text && <p set:html={inlineHtml(item.text)} />}
                </PathCard>
            ))
        }
    </Grid>
    {facts.length > 0 && <Facts items={facts} />}
    {section.ctas && <CtaRow ctas={section.ctas} />}
</Section>
