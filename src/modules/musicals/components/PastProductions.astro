---
import type { CollectionEntry } from 'astro:content';
import Button from '@/components/ui/Button.astro';
import Heading from '@/components/ui/Heading.astro';
import Section from '@/components/ui/Section.astro';

interface Props {
    id?: string | undefined;
    heading?: string | undefined;
    /** Badge label on posters that open a photo gallery. */
    note?: string | undefined;
    productions: CollectionEntry<'productions'>[];
}

const { id, heading, note, productions } = Astro.props;
---

<Section id={id}>
    {heading && <Heading text={heading} />}
    <div
        class="mt-[26px] grid grid-cols-2 gap-3 min-[601px]:grid-cols-[repeat(auto-fill,minmax(190px,1fr))] min-[601px]:gap-9"
        data-past-grid
    >
        {
            productions.map(({ id: key, data }) => {
                const colors = data.poster?.colors ?? ['#0b1240', '#2f6bf2'];
                const art = (
                    <div
                        class="art relative flex aspect-[3/4] flex-col items-center justify-between overflow-hidden px-2.5 pt-3.5 pb-[34px] text-center text-white min-[601px]:px-4 min-[601px]:pt-[22px]"
                        style={{ '--a': colors[0], '--b': colors[1] }}
                    >
                        <small class="poster-text text-[0.6rem] min-[601px]:text-[0.75rem]">
                            {data.year}
                        </small>
                        <strong class="poster-text mt-auto text-[0.9rem]">
                            {data.title}
                        </strong>
                        <em class="poster-text mt-1.5 text-[0.6rem] not-italic opacity-90 min-[601px]:text-[0.68rem]">
                            {data.poster?.credit}
                        </em>
                        {data.poster?.image && (
                            <img
                                src={data.poster.image.src}
                                alt={data.poster.image.alt}
                                width="380"
                                height="507"
                                loading="lazy"
                                decoding="async"
                                class="absolute inset-0 z-[2] size-full object-cover object-[50%_30%]"
                                style={
                                    data.poster.image.position
                                        ? {
                                              objectPosition:
                                                  data.poster.image.position,
                                          }
                                        : undefined
                                }
                            />
                        )}
                    </div>
                );
                return data.photos.length > 0 ? (
                    <button
                        type="button"
                        class="poster group relative block w-full cursor-pointer text-left"
                        data-gal={key}
                        data-photos={JSON.stringify(
                            data.photos.map(p => ({ src: p.src, alt: p.alt })),
                        )}
                        aria-label={`${data.title}, ${data.year}${note ? `: ${note.toLowerCase()}` : ''}`}
                    >
                        {art}
                        {note && (
                            <span class="border-navy text-navy group-hover:bg-pink group-focus-visible:bg-pink absolute right-2.5 bottom-2.5 z-[5] border-2 bg-white px-2 py-1 text-[0.62rem] font-bold group-hover:text-white group-focus-visible:text-white">
                                {note}
                            </span>
                        )}
                    </button>
                ) : (
                    <div
                        class="poster"
                        role="img"
                        aria-label={`${data.title}, ${data.year}`}
                    >
                        {art}
                    </div>
                );
            })
        }
    </div>

    <dialog
        class="galdlg border-navy bg-navy m-auto w-full max-w-[min(1100px,94vw)] border-[3px] p-0 text-white shadow-[0_15px_36px_rgba(10,14,42,0.16)] backdrop:bg-[rgba(7,10,31,0.85)]"
        aria-label="Show photos"
        data-past-dialog
    >
        <Button
            variant="enrol"
            size="sm"
            shadow="none"
            class="absolute top-2 right-2 z-[2] size-[42px] p-0 text-[1.6rem] leading-none"
            aria-label="Close"
            data-gal-close
        >
            &times;
        </Button>
        <Button
            variant="light"
            size="sm"
            shadow="navy"
            class="border-navy absolute top-[40%] left-2 z-[2] size-[46px] p-0 text-[1.3rem]"
            aria-label="Previous photo"
            data-gal-step="-1"
        >
            &larr;
        </Button>
        <figure class="m-0">
            <img
                alt=""
                class="block max-h-[78vh] w-full bg-black object-contain"
                data-gal-img
            />
            <figcaption
                class="px-4 py-3 text-[0.95rem] text-[#dfe4ff]"
                data-gal-caption
            >
            </figcaption>
        </figure>
        <Button
            variant="light"
            size="sm"
            shadow="navy"
            class="border-navy absolute top-[40%] right-2 z-[2] size-[46px] p-0 text-[1.3rem]"
            aria-label="Next photo"
            data-gal-step="1"
        >
            &rarr;
        </Button>
    </dialog>
</Section>

<style>
    .poster {
        border-top: 4px solid var(--color-cobalt);
        background: var(--color-navy);
        box-shadow: 0 9px 18px rgb(10 14 42 / 0.16);
    }
    .art {
        background: linear-gradient(160deg, var(--a), var(--b));
    }
    .art::after {
        content: '';
        position: absolute;
        inset: 0;
        z-index: 3;
        pointer-events: none;
        background: linear-gradient(rgb(7 10 31 / 0) 45%, rgb(7 10 31 / 0.8));
    }
    .poster-text {
        position: relative;
        z-index: 4;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        text-shadow: 0 2px 12px rgb(0 0 0 / 0.7);
    }
</style>

<script>
    type Photo = { src: string; alt: string };

    function initPastGalleries() {
        const dialog =
            document.querySelector<HTMLDialogElement>('[data-past-dialog]');
        if (!dialog || dialog.dataset.ready) return;
        dialog.dataset.ready = 'true';

        const img = dialog.querySelector<HTMLImageElement>('[data-gal-img]')!;
        const caption =
            dialog.querySelector<HTMLElement>('[data-gal-caption]')!;
        let photos: Photo[] = [];
        let index = 0;
        let x0: number | null = null;

        function show() {
            const photo = photos[index];
            if (!photo) return;
            img.src = photo.src;
            img.alt = photo.alt;
            caption.textContent = `${photo.alt}  (${index + 1} of ${photos.length})`;
        }
        function go(step: number) {
            if (!photos.length) return;
            index = (index + step + photos.length) % photos.length;
            show();
        }

        document
            .querySelectorAll<HTMLButtonElement>('[data-past-grid] [data-gal]')
            .forEach(button => {
                button.addEventListener('click', () => {
                    photos = JSON.parse(button.dataset.photos ?? '[]');
                    index = 0;
                    show();
                    dialog.showModal();
                });
            });

        dialog
            .querySelectorAll<HTMLButtonElement>('[data-gal-step]')
            .forEach(button =>
                button.addEventListener('click', () =>
                    go(Number(button.dataset.galStep)),
                ),
            );
        dialog
            .querySelector('[data-gal-close]')
            ?.addEventListener('click', () => dialog.close());
        dialog.addEventListener('click', event => {
            if (event.target === dialog) dialog.close();
        });
        dialog.addEventListener('keydown', event => {
            if (event.key === 'ArrowLeft') go(-1);
            if (event.key === 'ArrowRight') go(1);
        });
        img.addEventListener(
            'touchstart',
            event => {
                x0 = event.touches[0]?.clientX ?? null;
            },
            { passive: true },
        );
        img.addEventListener('touchend', event => {
            const x1 = event.changedTouches[0]?.clientX;
            if (x0 === null || x1 === undefined) return;
            const dx = x1 - x0;
            if (Math.abs(dx) > 40) go(dx < 0 ? 1 : -1);
            x0 = null;
        });
    }

    document.addEventListener('astro:page-load', initPastGalleries);
</script>
