---
import type { CollectionEntry } from 'astro:content';
import { inlineHtml } from '@/lib/content-text';

interface Props {
    camps: CollectionEntry<'camps'>[];
    /** Extra rows after the camps (e.g. auditions). */
    facts?: { label: string; value: string }[] | undefined;
}

const { camps, facts = [] } = Astro.props;

const rows = [
    ...camps.map(({ data }) => ({
        label: data.name,
        value: [data.dates, data.ages, data.price, data.location].join('\n'),
    })),
    ...facts,
];
---

<div
    class="bg-navy py-7"
    data-tone="paper"
>
    <dl
        class="wrap grid grid-cols-1 gap-x-[30px] sm:grid-cols-[repeat(auto-fit,minmax(190px,1fr))]"
    >
        {
            rows.map(row => (
                <div class="border-navy border-t-[3px] pt-3.5 pb-[18px]">
                    <dt class="font-ui text-pink mb-1.5 text-[0.95rem] font-semibold">
                        {row.label}
                    </dt>
                    <dd
                        class="mt-0.5 text-white"
                        set:html={inlineHtml(row.value)}
                    />
                </div>
            ))
        }
    </dl>
</div>
