---
import type { CollectionEntry } from 'astro:content';
import { cn } from '@/lib/cn';

type Image = CollectionEntry<'galleries'>['data']['images'][number];

interface Props {
    /** Tiles follow each image's `shape`: wide spans 2 cols, tall spans 2 rows. */
    images: Image[];
    class?: string | undefined;
}

const { images, class: className } = Astro.props;
---

<div
    class={cn(
        'mt-[26px] grid grid-flow-dense auto-rows-[160px] grid-cols-2 gap-2.5 md:auto-rows-[220px] md:grid-cols-4 md:gap-3.5',
        className,
    )}
>
    {
        images.map(image => (
            <figure
                class={cn(
                    'group border-navy shadow-soft m-0 overflow-hidden border-2',
                    image.shape === 'wide' && 'col-span-2',
                    image.shape === 'tall' && 'row-span-2',
                )}
            >
                <img
                    src={image.src}
                    alt={image.alt}
                    width={image.width ?? 800}
                    height={image.height ?? 600}
                    loading="lazy"
                    decoding="async"
                    class="block size-full object-cover transition-transform duration-500 group-hover:scale-105"
                    style={
                        image.position
                            ? { objectPosition: image.position }
                            : undefined
                    }
                />
            </figure>
        ))
    }
</div>
