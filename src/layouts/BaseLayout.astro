---
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import SiteFooter from '@/components/layout/SiteFooter.astro';
import NewsletterSignup from '@/components/layout/NewsletterSignup.astro';
import NewsletterPopup from '@/components/layout/NewsletterPopup.astro';
import { navKeyForPath, site, socials } from '@/data/site';
import '@/styles/global.css';

interface Props {
    /** Full document title, used as-is (pages own their SEO titles). */
    title: string;
    description?: string;
    /** Share image path or absolute URL. Defaults to /images/share.jpg. */
    image?: string;
    imageAlt?: string;
    /** Top-level nav key to highlight (home, classes, camps, shows, singoz, hire, about). Inferred from the URL when omitted. */
    active?: string;
    /** Hide the "Stay in the loop" newsletter band above the footer. */
    hideNewsletter?: boolean;
    /** Suppress the timed mailing-list popup. Always off on /thanks/ and 404. */
    hidePopup?: boolean | undefined;
    noindex?: boolean;
    /** Extra JSON-LD objects for this page (FAQPage, Event...). */
    jsonLd?: Record<string, unknown>[];
}

const {
    title,
    description = site.description,
    image = site.shareImage,
    imageAlt = 'Pelican Productions performers on stage',
    active,
    hideNewsletter = false,
    hidePopup = false,
    noindex = false,
    jsonLd = [],
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;
// Noindex pages and 404s (served at whatever URL was requested) get no canonical.
const showCanonical = !noindex && Astro.response.status !== 404;
const imageUrl = new URL(image, site.url).href;
const activeKey = active ?? navKeyForPath(Astro.url.pathname);
const showPopup =
    !hidePopup &&
    Astro.response.status !== 404 &&
    !/^\/(?:thanks|404)(?:\/|\.html)?$/.test(Astro.url.pathname);

const business = {
    '@context': 'https://schema.org',
    '@type': 'EntertainmentBusiness',
    name: site.name,
    url: site.url,
    email: site.email,
    logo: new URL(site.logo, site.url).href,
    image: new URL(site.shareImage, site.url).href,
    address: { '@type': 'PostalAddress', ...site.address },
    sameAs: socials.map(s => s.href),
};
---

<!doctype html>
<html lang={site.lang}>
    <head>
        <meta charset="utf-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1"
        />
        <title>{title}</title>
        <meta
            name="description"
            content={description}
        />
        {
            showCanonical && (
                <link
                    rel="canonical"
                    href={canonical}
                />
            )
        }
        {
            noindex && (
                <meta
                    name="robots"
                    content="noindex"
                />
            )
        }
        <meta
            name="theme-color"
            content={site.themeColor}
        />

        <link
            rel="icon"
            href="/favicon.svg"
            type="image/svg+xml"
        />
        <link
            rel="icon"
            href="/favicon.ico"
            sizes="32x32"
        />
        <link
            rel="apple-touch-icon"
            href="/apple-touch-icon.png"
        />
        <link
            rel="manifest"
            href="/site.webmanifest"
        />

        <meta
            property="og:type"
            content="website"
        />
        <meta
            property="og:site_name"
            content={site.name}
        />
        <meta
            property="og:locale"
            content={site.locale}
        />
        <meta
            property="og:url"
            content={canonical}
        />
        <meta
            property="og:title"
            content={title}
        />
        <meta
            property="og:description"
            content={description}
        />
        <meta
            property="og:image"
            content={imageUrl}
        />
        <meta
            property="og:image:alt"
            content={imageAlt}
        />
        <meta
            name="twitter:card"
            content="summary_large_image"
        />
        <meta
            name="twitter:title"
            content={title}
        />
        <meta
            name="twitter:description"
            content={description}
        />
        <meta
            name="twitter:image"
            content={imageUrl}
        />

        <Font
            cssVariable="--font-inter"
            preload={[{ weight: '400 800' }]}
        />
        <Font cssVariable="--font-caveat" />
        <Font cssVariable="--font-caveat-brush" />
        <Font cssVariable="--font-space-mono" />
        <Font
            cssVariable="--font-montserrat"
            preload={[
                { weight: 800, style: 'normal' },
                { weight: 500, style: 'normal' },
            ]}
        />

        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify(business)}
        />
        {
            jsonLd.map(data => (
                <script
                    is:inline
                    type="application/ld+json"
                    set:html={JSON.stringify(data)}
                />
            ))
        }

        <ClientRouter />
        <slot name="head" />
    </head>
    <body class="bg-navy min-h-dvh text-white">
        <a
            href="#main"
            class="sr-only-focusable bg-lightblue font-ui text-navy fixed top-2.5 left-2.5 z-[200] p-2 font-bold"
            >Skip to content</a
        >
        <SiteHeader active={activeKey} />
        <main
            id="main"
            tabindex="-1"
            class="outline-none"
        >
            <slot />
        </main>
        {!hideNewsletter && <NewsletterSignup />}
        <SiteFooter />
        {showPopup && <NewsletterPopup />}
    </body>
</html>
