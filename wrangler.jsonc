{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "pelican-productions",
    "account_id": "16a04bbc76ee5eccbcc1d6c39bc9a797",
    "main": "@astrojs/cloudflare/entrypoints/server",
    "compatibility_date": "2026-09-04",
    "compatibility_flags": [
        "nodejs_compat",
        // workerd process v2 makes Astro treat Workers as Node and return
        // async-iterable bodies, which render as "[object Object]".
        // https://github.com/withastro/astro/issues/14511
        "disable_nodejs_process_v2",
    ],
    "workers_dev": true,
    "routes": [],
    "assets": {
        "binding": "ASSETS",
        "directory": "./dist",
    },
    "vars": {
        "CONTACT_FROM_EMAIL": "website@send.pelicanproductions.com.au",
        "CONTACT_TO_EMAIL": "ahoy@pelicanproductions.com.au",
        // Newsletter audience. MAILCHIMP_API_KEY is a secret (.env locally).
        "MAILCHIMP_LIST_ID": "6b52c75cc1",
        // Public; baked into prerendered pages. `astro dev` uses the test key.
        "TURNSTILE_SITE_KEY": "0x4AAAAAAFV_ScTaXFFP9fuA",
    },
    // Cloudflare Email Service: contact form notifications.
    // The sender domain must be onboarded in Email Routing/Sending.
    "send_email": [
        {
            "name": "EMAIL",
        },
    ],
    "kv_namespaces": [
        {
            "binding": "SESSION",
            "id": "b7ab468127944be691fcb224c9f6f0b5",
        },
    ],
    // Preview deployments read bindings, vars and secrets from here, not the
    // top level. Secrets: `wrangler preview secret put <NAME>`.
    "previews": {
        "vars": {
            "CONTACT_FROM_EMAIL": "website@send.pelicanproductions.com.au",
            "CONTACT_TO_EMAIL": "ahoy@pelicanproductions.com.au",
            "MAILCHIMP_LIST_ID": "6b52c75cc1",
            "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
        },
        "send_email": [
            {
                "name": "EMAIL",
            },
        ],
        "kv_namespaces": [
            {
                "binding": "SESSION",
                "id": "b7ab468127944be691fcb224c9f6f0b5",
            },
        ],
    },
    "observability": {
        "enabled": true,
        "traces": {
            "enabled": true,
        },
    },
}
